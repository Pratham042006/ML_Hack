# Copy to .env (which is git-ignored) and edit. Nothing here is a secret.
# Folder that contains one sub-folder per trip, e.g. data/student_test/00000052/00000052.track
PATHSNAP_DATA_DIR=data/student_test
# Optional saved model artifact. Leave empty to use the documented baseline.
PATHSNAP_MODEL_ARTIFACT=
# 0.0.0.0 so another laptop can reach the API
PATHSNAP_API_HOST=0.0.0.0
PATHSNAP_API_PORT=8000
# UI (Laptop 2) -> API (Laptop 1), e.g. http://192.168.1.23:8000
VITE_API_URL=http://localhost:8000
